
<ion-header [translucent]="true">
  <ion-toolbar>
    <ion-title>CJK Hotel Reservation</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content [fullscreen]="true" class="home-content">

 
  <div class="welcome-section">

    <ion-img
      src="https://i.pinimg.com/1200x/fe/54/e1/fe54e1ea01ea996bd97d1f2b33907682.jpg"
      alt="Welcome to CJK">
    </ion-img>

    <div class="welcome-overlay">
      <h2>Welcome to CJK!</h2>
      <p>Where Elegance Meets Exceptional Comfort.</p>
    </div>

  </div>

  
  <ion-grid>
    <ion-row>

   
      <ion-col size="12" size-md="4">
        <ion-card class="dashboard-card">
          <ion-card-content>

            <ion-icon name="bed-outline"></ion-icon>
            <h2>Rooms</h2>
            <h1></h1>
            <p>Total Rooms</p>

          </ion-card-content>
        </ion-card>
      </ion-col>

   
      <ion-col size="12" size-md="4">
        <ion-card class="dashboard-card">
          <ion-card-content>

            <ion-icon name="calendar-outline"></ion-icon>
            <h2>Bookings</h2>
            <h1></h1>
            <p>Total Bookings</p>

          </ion-card-content>
        </ion-card>
      </ion-col>

      <ion-col size="12" size-md="4">
        <ion-card class="dashboard-card">
          <ion-card-content>

            <ion-icon name="star-outline"></ion-icon>
            <h2>Ratings</h2>
            <h1></h1>
            <p>Average Rating</p>

          </ion-card-content>
        </ion-card>
      </ion-col>

    </ion-row>
  </ion-grid>

  <ion-card class="featured-card">

    <ion-card-header class="featured-header">

      <ion-card-title>Featured Rooms</ion-card-title>

      <ion-button fill="clear">
        View All
        <ion-icon name="arrow-forward-outline" slot="end"></ion-icon>
      </ion-button>

    </ion-card-header>

    <ion-card-content>

      <div class="room-image">

        <ion-img
          src="https://i.pinimg.com/736x/b0/9a/2c/b09a2c008027a264692e4ac0364361d1.jpg"
          alt="Deluxe Room">
        </ion-img>

        <span class="popular-badge">
          <ion-icon name="flame-outline"></ion-icon>
          Popular
        </span>

      </div>

      <div class="room-details">

        <div class="room-info">

          <h1>Deluxe Room</h1>

          <h3>
            <ion-icon name="star-outline"></ion-icon>
            (250 reviews)
          </h3>

          <h1 class="room-price">₱3,000/night</h1>

        </div>

        <ion-button class="book-button">
          Book Now
        </ion-button>

      </div>

    </ion-card-content>

  </ion-card>

</ion-content>
